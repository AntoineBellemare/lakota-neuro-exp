        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Welcome to this experiment.&amp;#10;&amp;#10;You will see a series of visual designs (symbols).&amp;#10;&amp;#10;Your task is simply to look carefully at each design while keeping your eyes on the screen and staying as still as possible — try not to move your eyes, face, or hands, and keep blinking to a minimum.&amp;#10;&amp;#10;The experiment has a few short parts, and a brief instruction screen will appear before each one:&amp;#10;&amp;#10;1. Rest — relax and look at the fixation cross for about 1 minute.&amp;#10;&amp;#10;2. Quick viewing — each design appears for about 1 second and is shown 2 times.&amp;#10;&amp;#10;3. Longer viewing — each design is shown once for about 30 seconds. After each one, you will rate how meaningful it feels to you.&amp;#10;&amp;#10;4. Words — each design is shown once more, and you write 10 words it brings to mind.&amp;#10;&amp;#10;5. Rest — a final 1-minute rest period.&amp;#10;&amp;#10;There are 20 designs in total, each shown 4 times across the experiment (2 quick + 1 long + 1 words), in random order.&amp;#10;&amp;#10;Please stay relaxed and as still as possible throughout.&amp;#10;&amp;#10;When you are ready to begin, press the SPACE BAR to start." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
