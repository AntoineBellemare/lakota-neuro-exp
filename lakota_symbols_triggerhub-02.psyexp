      <CodeComponent name="init_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import time&amp;#10;import serial&amp;#10;from psychopy import core&amp;#10;&amp;#10;ser=serial.Serial('COM15')&amp;#10;&amp;#10;def send_trigger_phasic(ser, trigger_value, dur=0.05):&amp;#10;    start_time = core.getTime()&amp;#10;    ser.write(str.encode(chr(trigger_value)))&amp;#10;    elapsed = core.getTime()- start_time&amp;#10;    remaining = dur- elapsed&amp;#10;    if remaining &gt; 0:&amp;#10;       core.wait(remaining)&amp;#10;     # Reset back to 0 after the pulse&amp;#10;    ser.write(str.encode(chr(0)))&amp;#10;&amp;#10;def send_trigger_onflip_phasic(win, ser, trigger_value, dur=0.05):&amp;#10;    def turn_trigger_on():&amp;#10;        ser.write(str.encode(chr(trigger_value)))&amp;#10;        print(f&quot;[PHASIC-ON-FLIP] Trigger {trigger_value} sent.&quot;)&amp;#10;     # Schedule for next flip&amp;#10;    win.callOnFlip(turn_trigger_on)&amp;#10;    win.flip()&amp;#10;    core.wait(dur)&amp;#10;    ser.write(str.encode(chr(0)))&amp;#10;    print(&quot;[PHASIC-ON-FLIP] Trigger reset to 0.&quot;)&amp;#10;    &amp;#10;def reset_trigger_tonic(ser):&amp;#10;    ser.write(str.encode(chr(0)))&amp;#10;    print(&quot;[TONIC] Trigger reset to 0.&quot;)&amp;#10;    &amp;#10;def send_trigger_tonic(ser, trigger_value):&amp;#10;    ser.write(str.encode(chr(trigger_value)))&amp;#10;    print(f&quot;[TONIC] Trigger set to {trigger_value}. (Must reset later.)&quot;)&amp;#10;&amp;#10;# =========================&amp;#10;# FIRST-PRESENTATION ONLY (for familiarity screen)&amp;#10;# =========================&amp;#10;# Track which images have already been rated so we only ask once per symbol&amp;#10;seen_symbols = set()&amp;#10;RESTING_STATE = 11&amp;#10;IMAGE_ONSET = 12&amp;#10;IMAGE_LONG_ONSET = 13  &amp;#10;IMAGE_WORDS = 14" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as time from 'time';&amp;#10;import * as serial from 'serial';&amp;#10;import {core} from 'psychopy';&amp;#10;ser = new serial.Serial(&quot;COM15&quot;);&amp;#10;function send_trigger_phasic(ser, trigger_value, dur = 0.05) {&amp;#10;    var elapsed, remaining, start_time;&amp;#10;    start_time = core.getTime();&amp;#10;    ser.write(str.encode(chr(trigger_value)));&amp;#10;    elapsed = (core.getTime() - start_time);&amp;#10;    remaining = (dur - elapsed);&amp;#10;    if ((remaining &gt; 0)) {&amp;#10;        core.wait(remaining);&amp;#10;    }&amp;#10;    ser.write(str.encode(chr(0)));&amp;#10;}&amp;#10;function send_trigger_onflip_phasic(win, ser, trigger_value, dur = 0.05) {&amp;#10;    function turn_trigger_on() {&amp;#10;        ser.write(str.encode(chr(trigger_value)));&amp;#10;        console.log(`[PHASIC-ON-FLIP] Trigger ${trigger_value} sent.`);&amp;#10;    }&amp;#10;    psychoJS.window.callOnFlip(turn_trigger_on);&amp;#10;    psychoJS.window.flip();&amp;#10;    core.wait(dur);&amp;#10;    ser.write(str.encode(chr(0)));&amp;#10;    console.log(&quot;[PHASIC-ON-FLIP] Trigger reset to 0.&quot;);&amp;#10;}&amp;#10;function reset_trigger_tonic(ser) {&amp;#10;    ser.write(str.encode(chr(0)));&amp;#10;    console.log(&quot;[TONIC] Trigger reset to 0.&quot;);&amp;#10;}&amp;#10;function send_trigger_tonic(ser, trigger_value) {&amp;#10;    ser.write(str.encode(chr(trigger_value)));&amp;#10;    console.log(`[TONIC] Trigger set to ${trigger_value}. (Must reset later.)`);&amp;#10;}&amp;#10;seen_symbols = set();&amp;#10;RESTING_STATE = 11;&amp;#10;IMAGE_ONSET = 12;&amp;#10;IMAGE_LONG_ONSET = 13;&amp;#10;IMAGE_WORDS = 14;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="reset_trigger_tonic(ser);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="reset_trigger_tonic(ser)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
